{
  "id": "TPL-WEB-008",
  "name": "PHP information page exposed",
  "severity": "MEDIUM",
  "category": "Exposure",
  "description": "A common PHP information endpoint appears public.",
  "recommendation": "Remove phpinfo pages from production.",
  "tags": [
    "php",
    "web",
    "exposure"
  ],
  "confidence": "HIGH",
  "min_profile": 3,
  "preconditions": {
    "technologies": [
      "php"
    ],
    "http_status": [
      200,
      201,
      202,
      204,
      301,
      302,
      307,
      308,
      401,
      403
    ]
  },
  "request": {
    "method": "GET",
    "path": "/info.php"
  },
  "matcher_condition": "AND",
  "matchers": [
    {
      "type": "status",
      "part": "status",
      "values": [
        200
      ]
    },
    {
      "type": "word",
      "part": "body",
      "condition": "contains_all",
      "values": [
        "PHP Version",
        "phpinfo()"
      ]
    }
  ],
  "allow_degraded": false,
  "stop_at_first_match": true,
  "concept": "phpinfo",
  "validation": {
    "reject_soft404": true,
    "max_soft404_similarity": 0.9,
    "content_types": [
      "text/html"
    ],
    "require_same_origin": true,
    "verification": "CONFIRMED"
  }
}