{
  "id": "TPL-WEB-001",
  "name": "Debug endpoint exposed",
  "severity": "MEDIUM",
  "category": "Exposure",
  "description": "A common debug endpoint appears publicly accessible.",
  "recommendation": "Restrict or remove debug endpoints in production.",
  "tags": [
    "web",
    "exposure",
    "debug"
  ],
  "confidence": "HIGH",
  "request": {
    "method": "GET",
    "path": "/debug"
  },
  "matcher_condition": "AND",
  "matchers": [
    {
      "type": "status",
      "part": "status",
      "values": [
        200
      ]
    },
    {
      "type": "word",
      "part": "body",
      "condition": "contains",
      "values": [
        "debug"
      ]
    }
  ],
  "min_profile": 2,
  "allow_degraded": false,
  "stop_at_first_match": true,
  "preconditions": {
    "http_status": [
      200,
      201,
      202,
      204,
      301,
      302,
      307,
      308,
      401,
      403
    ]
  },
  "concept": "debug-endpoint",
  "validation": {
    "reject_soft404": true,
    "max_soft404_similarity": 0.9,
    "content_types": [
      "text/html",
      "application/json",
      "text/plain"
    ],
    "require_same_origin": true,
    "verification": "OBSERVED"
  }
}