{
  "id": "TPL-WEB-009",
  "name": "Spring Actuator health endpoint exposed",
  "severity": "INFO",
  "category": "Information",
  "description": "A Spring Actuator health endpoint appears publicly accessible.",
  "recommendation": "Review actuator exposure and require authorization for sensitive endpoints.",
  "tags": [
    "spring",
    "java",
    "web"
  ],
  "confidence": "MEDIUM",
  "min_profile": 3,
  "preconditions": {
    "technologies": [
      "spring",
      "java"
    ],
    "http_status": [
      200,
      201,
      202,
      204,
      301,
      302,
      307,
      308,
      401,
      403
    ]
  },
  "request": {
    "method": "GET",
    "path": "/actuator/health"
  },
  "matcher_condition": "AND",
  "matchers": [
    {
      "type": "status",
      "part": "status",
      "values": [
        200
      ]
    },
    {
      "type": "word",
      "part": "body",
      "condition": "contains",
      "values": [
        "status"
      ]
    }
  ],
  "allow_degraded": false,
  "stop_at_first_match": true,
  "concept": "actuator-health",
  "validation": {
    "reject_soft404": true,
    "max_soft404_similarity": 0.9,
    "content_types": [
      "application/json",
      "text/plain"
    ],
    "require_same_origin": true,
    "verification": "OBSERVED"
  }
}