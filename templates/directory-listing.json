{
  "id": "TPL-WEB-002",
  "name": "Directory listing detected",
  "severity": "MEDIUM",
  "category": "Exposure",
  "description": "The server appears to expose an auto-generated directory index.",
  "recommendation": "Disable directory indexing unless it is intentionally public.",
  "tags": [
    "web",
    "exposure",
    "listing"
  ],
  "confidence": "HIGH",
  "request": {
    "method": "GET",
    "path": "/"
  },
  "matcher_condition": "OR",
  "matchers": [
    {
      "type": "word",
      "part": "body",
      "condition": "contains",
      "values": [
        "Index of /"
      ]
    },
    {
      "type": "regex",
      "part": "body",
      "value": "<title>\\s*Index of\\s+/"
    }
  ],
  "min_profile": 3,
  "allow_degraded": false,
  "stop_at_first_match": true,
  "preconditions": {
    "http_status": [
      200,
      201,
      202,
      204,
      301,
      302,
      307,
      308,
      401,
      403
    ]
  },
  "concept": "directory-listing",
  "validation": {
    "reject_soft404": true,
    "max_soft404_similarity": 0.9,
    "content_types": [
      "text/html"
    ],
    "require_same_origin": true,
    "verification": "CONFIRMED"
  }
}