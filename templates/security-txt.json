{
  "id": "TPL-WEB-020",
  "name": "security.txt discovered",
  "severity": "INFO",
  "category": "Information",
  "description": "A security.txt contact file is publicly available.",
  "recommendation": "Keep vulnerability reporting contact details current.",
  "tags": [
    "security.txt",
    "discovery",
    "passive"
  ],
  "min_profile": 1,
  "concept": "security-txt",
  "requests": [
    {
      "method": "GET",
      "path": "/.well-known/security.txt",
      "timeout": 4.0
    }
  ],
  "matchers": [
    {
      "type": "word",
      "part": "body",
      "values": [
        "Contact:"
      ]
    }
  ],
  "validation": {
    "reject_soft404": true,
    "content_types": [
      "text/plain"
    ],
    "verification": "OBSERVED"
  }
}