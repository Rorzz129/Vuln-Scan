{
  "id": "TPL-TECH-NGINX-001",
  "name": "nginx version disclosure",
  "severity": "INFO",
  "category": "Technology",
  "description": "The Server header discloses the nginx version.",
  "recommendation": "Consider server_tokens off if version disclosure is unnecessary.",
  "tags": [
    "nginx",
    "technology",
    "passive"
  ],
  "min_profile": 1,
  "allow_degraded": true,
  "preconditions": {
    "technologies": [
      "nginx"
    ]
  },
  "requests": [
    {
      "method": "HEAD",
      "path": "/",
      "timeout": 4.0
    }
  ],
  "matchers": [
    {
      "type": "regex",
      "part": "header:Server",
      "value": "(?i)nginx/[0-9]+\\.[0-9]+"
    }
  ],
  "extractors": [
    {
      "name": "nginx_version",
      "type": "regex",
      "part": "header:Server",
      "pattern": "(?i)nginx/([0-9]+\\.[0-9]+(?:\\.[0-9]+)?)",
      "group": 1
    }
  ]
}