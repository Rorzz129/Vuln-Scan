{
  "id": "TPL-WEB-022",
  "name": "OpenID Connect metadata discovered",
  "severity": "INFO",
  "category": "Discovery",
  "description": "OpenID Connect discovery metadata is available.",
  "recommendation": "Review exposed authentication endpoints and supported flows.",
  "tags": [
    "openid",
    "oauth",
    "discovery"
  ],
  "min_profile": 2,
  "concept": "openid-metadata",
  "requests": [
    {
      "method": "GET",
      "path": "/.well-known/openid-configuration",
      "timeout": 4.0
    }
  ],
  "matcher_condition": "AND",
  "matchers": [
    {
      "type": "word",
      "part": "body",
      "values": [
        "issuer",
        "authorization_endpoint",
        "token_endpoint"
      ]
    }
  ],
  "validation": {
    "reject_soft404": true,
    "content_types": [
      "application/json",
      "text/json"
    ],
    "verification": "OBSERVED"
  }
}