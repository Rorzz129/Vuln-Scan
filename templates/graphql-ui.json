{
  "id": "TPL-WEB-010",
  "name": "GraphQL interface discovered",
  "severity": "INFO",
  "category": "Information",
  "description": "A common GraphQL endpoint or UI appears accessible.",
  "recommendation": "Confirm public GraphQL access is intentional and appropriately authorized.",
  "tags": [
    "graphql",
    "api",
    "web"
  ],
  "confidence": "MEDIUM",
  "min_profile": 3,
  "request": {
    "method": "GET",
    "path": "/graphql"
  },
  "matcher_condition": "OR",
  "matchers": [
    {
      "type": "word",
      "part": "body",
      "condition": "contains",
      "values": [
        "GraphQL",
        "graphiql"
      ]
    },
    {
      "type": "word",
      "part": "header:Content-Type",
      "condition": "contains",
      "values": [
        "application/json"
      ]
    }
  ],
  "allow_degraded": false,
  "stop_at_first_match": true,
  "preconditions": {
    "http_status": [
      200,
      201,
      202,
      204,
      301,
      302,
      307,
      308,
      401,
      403
    ]
  },
  "concept": "graphql-ui",
  "validation": {
    "reject_soft404": true,
    "max_soft404_similarity": 0.9,
    "content_types": [
      "text/html",
      "application/json"
    ],
    "require_same_origin": true,
    "verification": "OBSERVED"
  }
}