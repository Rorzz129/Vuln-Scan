{
  "id": "TPL-TECH-PRESTASHOP-001",
  "name": "PrestaShop application marker",
  "severity": "INFO",
  "category": "Technology",
  "description": "PrestaShop-specific markers were observed.",
  "recommendation": "Informational technology fingerprint.",
  "tags": [
    "prestashop",
    "technology",
    "passive"
  ],
  "min_profile": 1,
  "allow_degraded": false,
  "preconditions": {
    "technologies": [
      "PrestaShop"
    ],
    "http_status": [
      200,
      203
    ]
  },
  "requests": [
    {
      "method": "GET",
      "path": "/",
      "timeout": 5.0
    }
  ],
  "matcher_condition": "OR",
  "matchers": [
    {
      "type": "word",
      "part": "body",
      "values": [
        "prestashop"
      ]
    },
    {
      "type": "regex",
      "part": "headers",
      "value": "(?i)set-cookie:.*prestashop"
    }
  ],
  "extractors": [
    {
      "name": "prestashop_version",
      "type": "regex",
      "part": "body",
      "pattern": "(?i)PrestaShop(?:\\s+|[/@-])([0-9]+\\.[0-9]+(?:\\.[0-9]+){0,2})",
      "group": 1
    }
  ]
}