{
  "id": "TPL-WEB-005",
  "name": "Apache server-status exposed",
  "severity": "MEDIUM",
  "category": "Exposure",
  "description": "Apache server-status appears publicly accessible.",
  "recommendation": "Restrict server-status to trusted administrators.",
  "tags": [
    "apache",
    "web",
    "exposure"
  ],
  "confidence": "HIGH",
  "request": {
    "method": "GET",
    "path": "/server-status"
  },
  "matcher_condition": "AND",
  "matchers": [
    {
      "type": "status",
      "part": "status",
      "values": [
        200
      ]
    },
    {
      "type": "word",
      "part": "body",
      "condition": "contains",
      "values": [
        "Apache Server Status"
      ]
    }
  ],
  "min_profile": 2,
  "preconditions": {
    "technologies": [
      "apache"
    ],
    "http_status": [
      200,
      201,
      202,
      204,
      301,
      302,
      307,
      308,
      401,
      403
    ]
  },
  "allow_degraded": false,
  "stop_at_first_match": true,
  "concept": "server-status",
  "validation": {
    "reject_soft404": true,
    "max_soft404_similarity": 0.9,
    "content_types": [
      "text/html",
      "text/plain"
    ],
    "require_same_origin": true,
    "verification": "CONFIRMED"
  }
}