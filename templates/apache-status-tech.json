{
  "id": "TPL-APACHE-STATUS-001",
  "name": "Apache server-status exposed",
  "severity": "MEDIUM",
  "category": "Exposure",
  "description": "Apache server-status appears publicly accessible.",
  "recommendation": "Restrict server-status to trusted administrators.",
  "tags": [
    "apache",
    "exposure",
    "web"
  ],
  "min_profile": 2,
  "preconditions": {
    "technologies": [
      "Apache"
    ],
    "ports": [
      80,
      443
    ],
    "http_status": [
      200,
      301,
      302,
      401,
      403
    ]
  },
  "requests": [
    {
      "method": "GET",
      "path": "/server-status",
      "timeout": 5.0
    },
    {
      "method": "GET",
      "path": "/server-status?auto",
      "timeout": 5.0
    }
  ],
  "matcher_condition": "OR",
  "matchers": [
    {
      "type": "word",
      "part": "body",
      "values": [
        "Apache Server Status"
      ]
    },
    {
      "type": "word",
      "part": "body",
      "values": [
        "Total Accesses:"
      ]
    }
  ],
  "concept": "server-status",
  "validation": {
    "reject_soft404": true,
    "max_soft404_similarity": 0.9,
    "content_types": [
      "text/html",
      "text/plain"
    ],
    "require_same_origin": true,
    "verification": "CONFIRMED"
  }
}