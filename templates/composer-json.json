{
  "id": "TPL-WEB-011",
  "name": "composer.json exposed",
  "severity": "LOW",
  "category": "Exposure",
  "description": "A PHP Composer manifest appears publicly accessible.",
  "recommendation": "Avoid exposing dependency manifests unless explicitly intended.",
  "tags": [
    "php",
    "composer",
    "exposure"
  ],
  "min_profile": 3,
  "concept": "composer-manifest",
  "requests": [
    {
      "method": "GET",
      "path": "/composer.json",
      "timeout": 5.0
    }
  ],
  "matchers": [
    {
      "type": "word",
      "part": "body",
      "condition": "contains",
      "values": [
        "\"require\"",
        "\"autoload\""
      ]
    }
  ],
  "validation": {
    "reject_soft404": true,
    "content_types": [
      "application/json",
      "text/plain"
    ],
    "verification": "CONFIRMED"
  }
}