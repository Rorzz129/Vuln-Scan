{
  "id": "TPL-TECH-PHP-001",
  "name": "PHP version disclosure",
  "severity": "INFO",
  "category": "Technology",
  "description": "The HTTP response discloses a PHP version.",
  "recommendation": "Avoid unnecessary runtime version disclosure.",
  "tags": [
    "php",
    "technology",
    "passive"
  ],
  "min_profile": 1,
  "allow_degraded": true,
  "preconditions": {
    "technologies": [
      "PHP"
    ]
  },
  "requests": [
    {
      "method": "HEAD",
      "path": "/",
      "timeout": 4.0
    }
  ],
  "matchers": [
    {
      "type": "regex",
      "part": "header:X-Powered-By",
      "value": "(?i)PHP/[0-9]+\\.[0-9]+"
    }
  ],
  "extractors": [
    {
      "name": "php_version",
      "type": "regex",
      "part": "header:X-Powered-By",
      "pattern": "(?i)PHP/([0-9]+\\.[0-9]+(?:\\.[0-9]+)?)",
      "group": 1
    }
  ]
}